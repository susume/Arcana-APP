{
  "name": "arcana-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/premium-theme.css -o ./css/premium.css --minify",
    "build:ts": "tsc -p tsconfig.json",
    "sync": "node scripts/sync-embedded-content.mjs",
    "build": "npm run sync && npm run build:css && npm run build:ts",
    "test": "npm run sync && npm run build:ts && node tests/run-tests.mjs",
    "serve": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
